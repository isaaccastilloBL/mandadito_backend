NODE_ENV=production
HOST=0.0.0.0
PORT=4173
PUBLIC_ORIGIN=
MANDADITO_DATA_DIR=./data
MANDADITO_ADMIN_TOKEN=
OTP_SECRET=
DEV_OTP=0
# Docker/Caddy: 1 con TRUST_PROXY_IP. Railway: railway (usa X-Real-IP del proxy de Railway).
TRUST_PROXY=1
TRUST_PROXY_IP=172.30.240.2
OPERATOR_NAME=
SUPPORT_EMAIL=
SUPPORT_PHONE=525658297411
# SMS: elige Twilio o un webhook HTTPS propio autenticado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
SMS_VERIFY_WEBHOOK=
VERIFY_WEBHOOK_TOKEN=
WHATSAPP_VERIFY_WEBHOOK=
# Rutas: token de Mapbox Directions o tu propio servicio OSRM.
MAPBOX_DIRECTIONS_TOKEN=
ROUTING_BASE_URL=
# Push de Android: archivo privado de cuenta de servicio de Firebase.
FCM_SERVICE_ACCOUNT_FILE=
# Alternativa sin archivos (Railway): el JSON completo o en base64.
FCM_SERVICE_ACCOUNT_JSON=
# Push de iPhone: archivo .p8 privado de Apple.
APNS_KEY_FILE=
# Alternativa sin archivos (Railway): contenido del .p8 o en base64.
APNS_KEY=
APNS_KEY_ID=
APPLE_TEAM_ID=
APP_ID=com.mandadito.app
APNS_SANDBOX=0
